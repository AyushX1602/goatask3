# Copy to .env and fill in what you have. Every value below is OPTIONAL.
# With nothing set, the pipeline still runs end to end using the Bluesky
# provider only (see prd.md S10 — the zero-key quickstart).

# --- Search providers ---
# Only free/free-tier providers are supported.
#
# Dropped 5 Sep 2026:
#  - Commercial face-search APIs (FaceCheck.ID, Search4Faces, FaceSeek):
#    they paywall SOURCE URLS, which is the one field we need. See D-17.
#  - Azure / Bing Visual Search: the Bing Search APIs were RETIRED by
#    Microsoft on 11 Aug 2025 and no longer exist. See D-18.
#
# PRIMARY search backend (D-28). Google Cloud Vision, feature WEB_DETECTION.
# ~1,000 units/month free, and it accepts raw image bytes so there is no
# public-URL problem. Needs a GCP project with a billing account attached
# (the free tier does not charge). Simplest form is a plain API key with the
# Vision API enabled — no service account required.
GCV_API_KEY=

# SECONDARY backend. ~100 searches/month, and it needs a publicly reachable
# image URL, which is why it is not primary. See D-31 (S3 presigned GET).
SERPAPI_KEY=

# Lens escalation upload. Set SEARCH_LENS_UPLOAD=1 to let a plain local
# upload escalate to SerpApi Google Lens: when GCV yields no identity
# signal, the HEAD CROP (never the full photo) is uploaded DIRECTLY to
# SerpApi (POST /image → image_id, held ~10 min on SerpApi's side — never
# on a public image host) and Lens runs on that image_id. Upload failure
# degrades to a recorded skip reason — the GCV path is unaffected.
SEARCH_LENS_UPLOAD=0

# auto | gcv | serpapi.  'auto' uses whichever key is present, preferring
# gcv for its larger quota. The orchestrator does not care which is first
# as long as one of them works.
WEB_DETECT_BACKEND=auto

# Quality gate (D-23). Derived by measurement: embedding self-similarity
# holds >=0.95 down to ~43px then collapses (0.868 @ 31px, 0.767 @ 20px).
MIN_FACE_PX=50

# --- Search tuning (sane defaults; rarely need changing) ---
# 1 = if the primary backend returns no identity signal, escalate to the
# other backend before falling back to Bluesky. 0 = single-shot primary.
WEB_DETECT_ESCALATE=1
# Max LinkedIn SERP lookups per run during profile expansion (each costs
# one SerpApi search from the ~100/month free tier).
EXPAND_SERP_MAX_CALLS=2

# --- Bluesky crawl (keyless fallback only, D-21 — not the primary search path) ---
BLUESKY_CRAWL_LIMIT=300

# --- Matching (normally read from calibration/threshold.json, not here — R-09) ---
# MATCH_THRESHOLD=
# MATCH_MARGIN=

# --- Storage ---
# (IPFS/Pinata cut from MVP scope — the evidence bundle lives on disk and
# its hash is what gets anchored. Nothing else to configure here.)

# --- Chain ---
EVM_CHAIN=anvil
EVM_RPC_URL=http://127.0.0.1:8545
# Leave EVM_PRIVATE_KEY empty on anvil — a safe, public, well-known default
# key is used automatically (pipeline/chain/evm.py). A real key is REQUIRED
# for any non-anvil chain and must never be committed.
EVM_PRIVATE_KEY=
# Set after deploying: forge script script/Deploy.s.sol:Deploy --rpc-url
# http://127.0.0.1:8545 --broadcast   (see contracts/README or phases.md F8)
EVM_CONTRACT_ADDRESS=

# --- Evidence commitment salt (design.md 4.3) ---
# Generate once, keep secret, never commit. Required to reproduce a face
# commitment. If unset, the pipeline generates and stores one automatically
# on first run at .cache/commitment_salt.bin.
FACE_COMMITMENT_SALT_HEX=

# --- Misc ---
HTTP_CACHE=1
