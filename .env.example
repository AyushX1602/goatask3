# Copy to .env and fill in what you have. Every value below is OPTIONAL.
# With nothing set, the pipeline still runs end to end using the Bluesky
# provider only (see prd.md S10 — the zero-key quickstart).

# --- Search providers ---
SERPAPI_KEY=
AZURE_VISION_KEY=
AZURE_VISION_ENDPOINT=
FACECHECK_KEY=
SEARCH4FACES_KEY=

# --- Bluesky crawl ---
BLUESKY_CRAWL_LIMIT=2000
BLUESKY_SEED_HANDLES=

# --- Matching (normally read from calibration/threshold.json, not here — R-09) ---
# MATCH_THRESHOLD=
# MATCH_MARGIN=

# --- Storage ---
PINATA_JWT=

# --- Chain ---
EVM_CHAIN=anvil
EVM_RPC_URL=http://127.0.0.1:8545
EVM_PRIVATE_KEY=
EVM_CONTRACT_ADDRESS=

# --- Evidence commitment salt (design.md 4.3) ---
# Generate once, keep secret, never commit. Required to reproduce a face
# commitment. If unset, the pipeline generates and stores one automatically
# on first run at .cache/commitment_salt.bin.
FACE_COMMITMENT_SALT_HEX=

# --- Misc ---
HTTP_CACHE=1
